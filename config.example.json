{
  "bot": {
    "token": "123456:replace-me",
    "mode": "poll",
    "log_level": "trace"
  },
  "server": {
    "port": "8080",
    "webhook_path": "/webhook",
    "webhook_secret": ""
  },

  "stats": {
    "persistence_file": "",
    "prometheus": {
      "enabled": true,
      "path": "/metrics",
      "token": "replace-me"
    }
  },

  "admin": {
    "usernames": []
  },

  "llm": {
    "providers": [
      {
        "name": "gemini-primary",
        "weight": 3,
        "gemini": {
          "model": "gemini-3.6-flash",
          "api_key_env": "GEMINI_API_KEY",
          "thinking_budget": 256
        }
      },
      {
        "name": "huggingface-primary",
        "weight": 1,
        "huggingface": {
          "model": "meta-llama/Llama-3.3-70B-Instruct",
          "api_key_env": "HF_API_KEY"
        }
      }
    ],
    "load_balancing": {
      "algorithm": "round_robin"
    },
    "rate_limit": {
      "max_concurrent": 16,
      "per_user_limit": 2,
      "per_user_window_seconds": 15,
      "max_users": 100000,
      "prune_interval_seconds": 1800
    },
    "system_prompt": ""
  },

  "anek": {
    "enabled": true,
    "inline": {
      "enabled": true,
      "ai_jokes": true,
      "ai_joke_prompt_template": "",
      "promotions": {
        "frequency": 0.2,
        "items": [
          { "message": "Test channel", "weight": 3, "link": "https://t.me/telegram" },
          { "message": "Test promo with link", "weight": 2, "link": "https://example.com" },
          { "message": "Test promo without link", "weight": 1 }
        ]
      }
    }
  },

  "questions": {
    "enabled": true
  },

  "swearing": {
    "enabled": true,
    "words_file": ""
  }
}
